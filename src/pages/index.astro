---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hello, World!</h1>
			<p>
				Welcome to my corner of the internet. Here you will find details about my past and 
				ongoing projects as blog entries.
			</p>
			<p>
				Head over to the <code>Blog</code> section to check out my writings. If you want to have some fun, 
				head to the <a href="https://sim.tsadarsh.com">simulator</a>.
			</p>			
			<p>
				After completing my Masters in Electrical and Computer Engineering from Geogia Tech in 2026 I started working
				as a firmware engineer with the Intel Xeon Server team.
			</p>
			<p>
				Outside of work, I am usually found (you guessed it right) behind my computer screen learning a new framework 
				or reading the latest digest of <a href="https://news.ycombinator.com">Hacker News</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
